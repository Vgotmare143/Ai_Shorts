{
  "name": "ai-shorts",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @ai-shorts/api",
    "dev:worker": "npm run dev --workspace @ai-shorts/worker",
    "dev:mobile": "npm run start --workspace @ai-shorts/mobile",
    "dev:n8n": "node scripts/start-n8n.mjs",
    "n8n:build": "node scripts/build-n8n-workflow.mjs",
    "db:migrate": "npx supabase db push",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "supabase@2.119.0": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}
